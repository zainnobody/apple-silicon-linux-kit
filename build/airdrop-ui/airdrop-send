#!/usr/bin/env bash
# Send the given files to a nearby AirDrop device. Opens a window if none is open, asks which device, then sends.
# Needs the root part of airdrop-persist.sh (helpers in /usr/lib/omdrop and the polkit policy).
[ $# -gt 0 ] || { echo "usage: airdrop-send FILE..." >&2; exit 2; }
H=/usr/lib/omdrop/omdrop-discoverable
S=/usr/lib/omdrop/send-to-peer
# Look: the flat AirDrop icon if installed (airdrop-ui/install-icon.sh), else the theme icon. A file path works in every notification server.
ICON=emblem-shared
M3_ICON="${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor/scalable/apps/m3-airdrop.svg"
[ -e "$M3_ICON" ] && ICON=$M3_ICON
note() { notify-send -a AirDrop -i "$ICON" "$1" "$2"; }
"$H" status --json | grep -q '"visible":true' || airdrop-on 600 || exit 1
# Lookup names; one row per device. The first field is the MAC, the rest is signal and name.
rows=$("$S" --list --names 2>/dev/null | grep -E '^[[:space:]]*([0-9a-f]{2}:){5}[0-9a-f]{2}')
[ -n "$rows" ] || { note "No device found" "Open AirDrop on the other device. Set it to Everyone."; exit 1; }
args=()
while IFS= read -r line; do
	mac=$(echo "$line" | awk '{print $1}')
	args+=("$mac" "$(echo "$line" | sed -E 's/^[[:space:]]*[^[:space:]]+[[:space:]]+//')")
done <<< "$rows"
mac=$(kdialog --title "AirDrop" --icon "$ICON" --menu "Choose a device" "${args[@]}") || exit 0
if out=$("$S" --mac "$mac" --wait 60 "$@" 2>&1); then
	note "Sent" "$# file(s) sent."
else
	note "Not sent" "$(echo "$out" | tail -2)"
	exit 1
fi
