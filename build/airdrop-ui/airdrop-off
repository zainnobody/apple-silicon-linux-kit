#!/usr/bin/env bash
# Close the AirDrop visibility window.
systemctl --user stop airdrop-receiver.service
if pkexec /usr/lib/omdrop/omdrop-discoverable stop; then
	# awdl0 stays after a window, so the sleep guard stays too. Without awdl0 there is nothing to guard.
	if ip link show awdl0 >/dev/null 2>&1; then
		notify-send -a AirDrop -i emblem-shared "AirDrop is off" "No longer visible. Sleep stays blocked until the next reboot."
	else
		systemctl --user stop airdrop-sleep-guard.service 2>/dev/null
		notify-send -a AirDrop -i emblem-shared "AirDrop is off" "No longer visible."
	fi
fi
