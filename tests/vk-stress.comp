#version 450
// Shader for tests/vk-stress.c: the gles-stress and metal-stress math as a compute kernel.
layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, set = 0, binding = 0) buffer Out { uint v[]; } out_buf;
layout(push_constant) uniform Push { uint seed; } pc;

void main()
{
	uint x = gl_GlobalInvocationID.x, y = gl_GlobalInvocationID.y;
	uint s = (x * 73856093u) ^ (y * 19349663u) ^ pc.seed;
	for (uint i = 0u; i < 400u; i++) {
		s ^= s << 13;
		s ^= s >> 17;
		s ^= s << 5;
		s += i;
	}
	out_buf.v[y * 1024u + x] = s;
}
