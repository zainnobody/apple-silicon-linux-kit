#version 450
// Shader for tests/vk-compute.c: out[i] = i * 3 + 7.
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Out { uint v[]; } out_buf;
layout(push_constant) uniform Push { uint count; } pc;

void main()
{
	uint i = gl_GlobalInvocationID.x;
	if (i < pc.count)
		out_buf.v[i] = i * 3u + 7u;
}
