[Unit]
Description=LibrePods (AirPods features), tray only
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
Environment=QT_QPA_PLATFORM=wayland
Environment=QT_LOGGING_RULES=librepods.debug=true
ExecStart=%h/librepods-build/linux/build/librepods --hide
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
