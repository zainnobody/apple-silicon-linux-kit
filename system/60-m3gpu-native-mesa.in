#!/bin/sh
# systemd user environment generator:
#   /etc/systemd/user-environment-generators/60-m3gpu-native-mesa
# Runs when each user manager starts (the login screen's and yours). Prints the
# native Mesa environment only when the native G15 GPU driver is bound, so the
# stock Fedora kernel keeps the system Mesa.
# Off switch: create /etc/m3gpu-native-mesa.off
P=@MESA_PREFIX@
[ -e /etc/m3gpu-native-mesa.off ] && exit 0
[ -e /sys/bus/platform/drivers/asahi-g15/@M3_GPU_NODE@ ] || exit 0
[ -e /dev/dri/renderD128 ] || exit 0
[ -r "$P/lib64/libEGL.so.1" ] && [ -r "$P/lib64/dri/asahi_dri.so" ] || exit 0
echo "LD_LIBRARY_PATH=$P/lib64"
echo "LIBGL_DRIVERS_PATH=$P/lib64/dri"
echo "GBM_BACKENDS_PATH=$P/lib64/gbm"
echo "VK_DRIVER_FILES=$P/share/vulkan/icd.d/asahi_icd.aarch64.json"
echo "VK_ICD_FILENAMES=$P/share/vulkan/icd.d/asahi_icd.aarch64.json"
echo "VK_LOADER_LAYERS_DISABLE=~implicit~"
echo "QSG_RHI_BACKEND=opengl"
echo "M3GPU_NATIVE_MESA=1"
