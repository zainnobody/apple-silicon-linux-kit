# Boot service: runs agx-mesa-select before the login screen starts.
[Unit]
Description=Select the native Apple GPU Mesa when the native GPU driver is bound
After=systemd-udev-settle.service local-fs.target
Before=display-manager.service systemd-user-sessions.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/agx-mesa-select
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
