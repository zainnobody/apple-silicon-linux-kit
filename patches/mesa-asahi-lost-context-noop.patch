+
+/* Marks the context lost and reports the reset once. */
+static inline void
+agx_context_mark_lost(struct agx_context *ctx)
+{
+   const bool first_fault = !ctx->any_faults;
+   ctx->any_faults = true;
+   if (first_fault && ctx->reset.reset)
+      ctx->reset.reset(ctx->reset.data, PIPE_GUILTY_CONTEXT_RESET);
+}
+
+/* True when GPU work of this context can no longer run: an earlier job
+ * faulted, or the kernel refuses the device's VM. Entry points that build GPU
+ * work return early, as GL robustness requires after a reset. */
+static inline bool
+agx_context_lost(struct agx_context *ctx)
+{
+   if (unlikely(p_atomic_read(&agx_device(ctx->base.screen)->lost)))
+      agx_context_mark_lost(ctx);
+
+   return unlikely(ctx->any_faults);
 }
 
