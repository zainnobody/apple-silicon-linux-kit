+/// Diagnostic: the bound sensor's CPOL/CPHA bits as a mode number 0..=3.
+pub(crate) fn spi_mode() -> Option<u32> {
+    // SAFETY: reads one int under the shim's lock.
+    let m = unsafe { sep_sensor_get_mode() };
+    if m < 0 {
+        None
+    } else {
+        Some(m as u32)
+    }
+}
+
+/// Diagnostic: switches the bound sensor to SPI mode 0..=3.
+pub(crate) fn set_spi_mode(mode: u32) -> bool {
+    // SAFETY: the shim validates the mode and holds the bus lock.
+    unsafe { sep_sensor_set_mode(mode) == 0 }
+}
