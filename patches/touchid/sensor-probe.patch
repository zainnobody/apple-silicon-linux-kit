+/*
+ * Diagnostic (sensor_probe): switch the CPOL/CPHA bits of the bound sensor and
+ * re-run spi_setup(), which re-applies the chip-select timing. Nothing else
+ * about the device changes.
+ */
+static int sep_sensor_set_mode_locked(unsigned int mode)
+{
+	struct spi_controller *ctlr;
+	int rc;
+
+	if (!sep_spi)
+		return -ENODEV;
+	if (mode > SPI_MODE_3)
+		return -EINVAL;
+	ctlr = sep_spi->controller;
+	rc = spi_bus_lock(ctlr);
+	if (rc)
+		return rc;
+	sep_spi->mode = (sep_spi->mode & ~(SPI_CPOL | SPI_CPHA)) | mode;
+	rc = spi_setup(sep_spi);
+	spi_bus_unlock(ctlr);
+	return rc;
+}
+
+static int sep_sensor_get_mode_locked(void)
+{
+	if (!sep_spi)
+		return -ENODEV;
+	return sep_spi->mode & (SPI_CPOL | SPI_CPHA);
+}
+
+int sep_sensor_set_mode(unsigned int mode)
+{
+	struct sep_sensor_lifetime *sensor = sep_lock_sensor();
+	int result;
+
+	if (!sensor)
+		return -ENODEV;
+	result = sep_sensor_set_mode_locked(mode);
+	mutex_unlock(&sensor->lock);
+	return result;
+}
+
+int sep_sensor_get_mode(void)
+{
+	struct sep_sensor_lifetime *sensor = sep_lock_sensor();
+	int result;
+
+	if (!sensor)
+		return -ENODEV;
+	result = sep_sensor_get_mode_locked();
+	mutex_unlock(&sensor->lock);
+	return result;
+}
