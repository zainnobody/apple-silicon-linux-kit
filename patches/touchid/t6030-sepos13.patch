+/// MacBook Pro 16-inch, M3 Pro (J516S) on system firmware 15.6 (iBoot 11881).
+/// The first stage 3b load (2026-10-27, variant-5 create inherited from T8112)
+/// got "CREATE_KEYBAG ... mailbox status -13, empty reply", the same answer the
+/// M2 Pro/Max enclaves on 26.0 and 26.2 give: an older sepOS that takes only
+/// the 13.5 key store. The J516S ADT carries `/defaults` `cpx-encryption-mode`
+/// = 2. Everything else is [`T6030`].
+pub(crate) const T6030_SEPOS13: PlatformProfile = PlatformProfile {
+    name: "T6030/J516s (13.5 key store)",
+    keybag_create: KeybagCreate {
+        variant: T8103.keybag_create.variant,
+        bag_type: T8103.keybag_create.bag_type,
+        arg: T8103.keybag_create.arg,
+    },
+    key_store: KeyStore::Sepos13 {
+        cpx_encryption_mode: 2,
+    },
+    ..T6030
+};
+
 static_assert!(T8103.shmem_capacity == 0x30000);
 static_assert!(T6020.shmem_capacity == 0x40000);
 static_assert!(T8140.shmem_capacity == 0x40000);
