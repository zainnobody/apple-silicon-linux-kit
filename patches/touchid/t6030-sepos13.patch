+/// The J516S profile for the machine's system firmware, by the same rule as
+/// [`t6020_profile`]: an iBoot build before 26.3's takes the 13.5 key store;
+/// a missing or newer build keeps [`T6030`].
+fn t6030_profile() -> &'static PlatformProfile {
+    let iboot = chosen_string(c"asahi,iboot1-version");
+    let firmware = chosen_string(c"asahi,system-fw-version");
+    let os_firmware = chosen_string(c"asahi,os-fw-version");
+    let sepos13 = iboot
+        .as_deref()
+        .and_then(parse_iboot_build)
+        .is_some_and(|build| build < T6020_SEPOS13_BEFORE);
+    let profile = if sepos13 { &T6030_SEPOS13 } else { &T6030 };
+    pr_info_once!(
+        "M3 Pro on system firmware {} ({}), OS firmware {}: using {}\n",
+        shown(&firmware),
+        shown(&iboot),
+        shown(&os_firmware),
+        if sepos13 {
+            "the 13.5 key store"
+        } else {
+            "the variant-5 key store"
+        }
+    );
+    profile
+}
+
