+    // Restart the capture of a sensor that is armed and waits for a finger. Modes 1 and 2 send idle
+    // first and wait up to 50 ms for the idle state; mode 3 sends the start command alone.
+    fn rearm_sensor(&self, mode: u32) -> bool {
+        if mode != 3 {
+            if sensor::idle().is_err() {
+                return false;
+            }
+            for _ in 0..10 {
+                match sensor::status() {
+                    Ok(st) if st.state == sensor::STATE_IDLE => break,
+                    Ok(_) => {}
+                    Err(_) => return false,
+                }
+                kernel::time::delay::fsleep(kernel::time::Delta::from_millis(5));
+            }
+        }
+        sensor::start_capture().is_ok()
+    }
