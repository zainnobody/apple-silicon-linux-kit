--- a/drivers/hwmon/macsmc-hwmon.c
+++ b/drivers/hwmon/macsmc-hwmon.c
@@ -23,6 +23,7 @@
 #include <linux/bitfield.h>
 #include <linux/ctype.h>
 #include <linux/debugfs.h>
+#include <linux/delay.h>
 #include <linux/hwmon.h>
 #include <linux/math64.h>
 #include <linux/mfd/macsmc.h>
@@ -504,9 +505,23 @@
 
 	if (val >= min && val <= max) {
 		if (!hwmon->fan.fans[channel].manual) {
+			int tries;
+
 			/* Write 1 to mode key for manual control */
 			ret = macsmc_hwmon_write_key(hwmon->smc,
 						     &hwmon->fan.fans[channel].mode, 1);
+			/*
+			 * M3 and M4 firmware rejects the mode write while the fans are in
+			 * system mode, until the Ftst flag is set. Then the mode write is
+			 * accepted after a few seconds.
+			 */
+			for (tries = 0; ret < 0 && tries < 20; tries++) {
+				if (!tries)
+					apple_smc_write_u8(hwmon->smc, _SMC_KEY("Ftst"), 1);
+				msleep(500);
+				ret = macsmc_hwmon_write_key(hwmon->smc,
+							     &hwmon->fan.fans[channel].mode, 1);
+			}
 			if (ret < 0)
 				return ret;
 
@@ -523,6 +538,15 @@
 
 			hwmon->fan.fans[channel].manual = false;
 		}
+		/* Clear Ftst once no fan is in manual mode, so the SMC owns the fans again. */
+		{
+			int i, any = 0;
+
+			for (i = 0; i < hwmon->fan.count; i++)
+				any |= hwmon->fan.fans[i].manual;
+			if (!any)
+				apple_smc_write_u8(hwmon->smc, _SMC_KEY("Ftst"), 0);
+		}
 	} else {
 		return -EINVAL;
 	}
