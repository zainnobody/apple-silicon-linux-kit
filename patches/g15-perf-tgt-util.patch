+/// Firmware DVFS target utilization override, percent (0: the template value, 80).
+pub(crate) fn perf_tgt_util() -> u32 {
+    match *module_parameters::g15_perf_tgt_util.value() {
+        0 => 0,
+        v => v.clamp(30, 95),
+    }
+}
