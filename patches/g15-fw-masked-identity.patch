+/// Admission by image UUID plus the TEXT digest with the whole patchbay zeroed, for the builds
+/// that name one. `copy` has its entropy bytes zeroed; `m` is the full measurement.
+fn masked_build(
+    copy: &[u8],
+    at: usize,
+    m: &Measured,
+    builds: &'static [FirmwareBuild],
+) -> Result<Option<&'static FirmwareBuild>> {
+    let Some((uuid, patchbay)) = lookup::image_info(copy, at) else {
+        return Ok(None);
+    };
+    let mut masked = KVVec::from_elem(0u8, copy.len(), GFP_KERNEL)?;
+    masked.copy_from_slice(copy);
+    masked[patchbay].fill(0);
+    let measured = Measured {
+        sha256: glue::sha256(&masked),
+        ..*m
+    };
+    let qualified = builds.iter().map(|b| {
+        b.masked.as_ref().map(|id| {
+            (
+                Measured {
+                    text_size: b.text_size,
+                    data_size: b.data_size,
+                    marker: b.marker,
+                    sha256: id.sha256,
+                },
+                id.uuid,
+                b.machine.map_or(true, glue::machine),
+            )
+        })
+    });
+    Ok(lookup::masked_verdict(&measured, &uuid, qualified).and_then(|i| builds.get(i)))
+}
