+/// Offset of the image-info header in TEXT.
+const IMAGE_INFO: usize = 0x4200;
+
+/// The image-info header fields admission uses: the image UUID and the patchbay range. `None`
+/// unless the header is well formed (branch word, `uuid` magic, version 5, TEXT size equal to
+/// `text.len()`) and the patchbay holds the GKTS marker at `marker` and its entropy bytes.
+pub(crate) fn image_info(text: &[u8], marker: usize) -> Option<([u8; 16], core::ops::Range<usize>)> {
+    let word = |o: usize| -> Option<usize> {
+        let b = text.get(IMAGE_INFO + o..IMAGE_INFO + o + 4)?;
+        Some(u32::from_le_bytes([b[0], b[1], b[2], b[3]]) as usize)
+    };
+    if word(0)? != 0x1400_0011 || word(4)? != 0x6469_7575 || word(8)? != 5 {
+        return None;
+    }
+    if word(0x34)? != text.len() {
+        return None;
+    }
+    let start = word(0x2c)?;
+    let end = start.checked_add(word(0x30)?)?;
+    if end > text.len() || marker < start || marker.checked_add(16)? > end {
+        return None;
+    }
+    let mut uuid = [0u8; 16];
+    uuid.copy_from_slice(text.get(IMAGE_INFO + 0x14..IMAGE_INFO + 0x24)?);
+    Some((uuid, start..end))
+}
+
+/// Looks the patchbay-masked digest `m` (its `sha256` is the digest with the whole patchbay
+/// zeroed) and the image `uuid` up in `qualified`: each build's masked identity, if it has one,
+/// and whether this machine is the one it names. Same size, marker and machine rules as
+/// [`verdict`]; the UUID must be equal too.
+pub(crate) fn masked_verdict(
+    m: &Measured,
+    uuid: &[u8; 16],
+    qualified: impl IntoIterator<Item = Option<(Measured, [u8; 16], bool)>>,
+) -> Option<usize> {
+    qualified.into_iter().position(|q| {
+        q.map_or(false, |(q, q_uuid, machine)| {
+            q_uuid == *uuid
+                && matching::exact(
+                    (q.text_size, q.data_size),
+                    (m.text_size, m.data_size),
+                    q.marker,
+                    m.marker as usize,
+                    &q.sha256,
+                    &m.sha256,
+                    machine,
+                )
+        })
+    })
+}
