+    const TEXT: usize = 0x5c000;
+    const PB: usize = 0x58e88;
+
+    /// A TEXT image with a valid header, the patchbay `[PB, PB + 0x1e8)` and the marker in it.
+    fn image(uuid_byte: u8) -> Vec<u8> {
+        let mut t = vec![0u8; TEXT];
+        for (o, v) in [(0usize, 0x1400_0011u32), (4, 0x6469_7575), (8, 5), (0x2c, PB as u32),
+                       (0x30, 0x1e8), (0x34, TEXT as u32)] {
+            t[IMAGE_INFO + o..IMAGE_INFO + o + 4].copy_from_slice(&v.to_le_bytes());
+        }
+        t[IMAGE_INFO + 0x14..IMAGE_INFO + 0x24].fill(uuid_byte);
+        t[PB..PB + 8].copy_from_slice(&MARKER);
+        for (i, b) in t[PB + 16..PB + 0x1e8].iter_mut().enumerate() {
+            *b = (i * 7) as u8;
+        }
+        for (i, b) in t[0x100..0x4000].iter_mut().enumerate() {
+            *b = (i * 13 + 1) as u8;
+        }
+        t
+    }
+
+    /// What admission measures: the masked digest stand-in is the masked image itself.
+    fn masked_form(t: &[u8]) -> Vec<u8> {
+        let (_, pb) = image_info(t, PB).unwrap();
+        let mut m = t.to_vec();
+        m[pb].fill(0);
+        m
     }
+
+    fn measured_of(bytes: &[u8]) -> Measured {
+        let mut sha256 = [0u8; 32];
+        for (i, b) in bytes.iter().enumerate() {
+            sha256[i % 32] = sha256[i % 32].wrapping_mul(31).wrapping_add(*b).wrapping_add(i as u8);
+        }
+        Measured { text_size: TEXT as u64, data_size: 0x114000, marker: PB as u32, sha256 }
+    }
+
+    fn pinned(t: &[u8], uuid: u8, machine: bool) -> Option<(Measured, [u8; 16], bool)> {
+        Some((measured_of(&masked_form(t)), [uuid; 16], machine))
+    }
+
+    #[test]
+    fn reads_uuid_and_patchbay() {
+        let (uuid, pb) = image_info(&image(0xdb), PB).unwrap();
+        assert_eq!(uuid, [0xdb; 16]);
+        assert_eq!(pb, PB..PB + 0x1e8);
