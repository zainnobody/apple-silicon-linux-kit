+
+    #[test]
+    fn refuses_a_malformed_header() {
+        let mut t = image(1);
+        t[IMAGE_INFO + 4] ^= 1;
+        assert!(image_info(&t, PB).is_none());
+        let mut t = image(1);
+        t[IMAGE_INFO + 0x34] ^= 1;
+        assert!(image_info(&t, PB).is_none());
+        // the marker must lie inside the patchbay
+        assert!(image_info(&image(1), PB - 8).is_none());
+        assert!(image_info(&image(1), PB + 0x1e8).is_none());
+        // patchbay past the end of TEXT
+        let mut t = image(1);
+        t[IMAGE_INFO + 0x30..IMAGE_INFO + 0x34].copy_from_slice(&0x10_0000u32.to_le_bytes());
+        assert!(image_info(&t, PB).is_none());
+    }
+
+    #[test]
+    fn a_patchbay_change_keeps_the_masked_identity() {
+        // The patchbay holds the UAT addresses: another RAM size changes them.
+        let known = image(0xdb);
+        let mut other = image(0xdb);
+        other[PB + 0x60] ^= 0xff; // an address slot
+        other[PB + 0x1d0] ^= 0x01; // a late slot
+        assert_ne!(known, other);
+        assert_eq!(masked_form(&known), masked_form(&other));
+        let m = measured_of(&masked_form(&other));
+        assert_eq!(masked_verdict(&m, &[0xdb; 16], [pinned(&known, 0xdb, true)]), Some(0));
+    }
