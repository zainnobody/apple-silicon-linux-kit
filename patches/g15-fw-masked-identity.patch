+            let mut other = image(0xdb);
+            other[at] ^= 1;
+            let m = measured_of(&masked_form(&other));
+            assert_eq!(masked_verdict(&m, &[0xdb; 16], [pinned(&known, 0xdb, true)]), None, "{at:#x}");
+        }
+    }
