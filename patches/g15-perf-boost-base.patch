+/// The boost and base-state module parameters. Each override is refused unless its words hold
+/// the template values, so a changed record layout cannot take a write at a wrong offset.
+fn perf_overrides(dev: &device::Device, hw_img: &mut [u8]) -> Result {
+    use super::board::words::{f32_div, f32_from_u32};
+    const F_0_95: u32 = 0x3f733333;
+    let top = board::DVFS_STATES as u32 - 1;
+    let range = |base: u32| f32_div(f32_from_u32(top - base), F_0_95).ok_or(EINVAL);
+    let boost_min = super::params::perf_boost_min();
+    let boost_step = super::params::perf_boost_step();
+    if boost_min != 0 || boost_step != 0 {
+        let (min, step) = (get32(hw_img, hwdata::PERF_BOOST_MIN)?, get32(hw_img, hwdata::PERF_BOOST_STEP)?);
+        if min != 90 || step != 50 {
+            dev_err!(dev, "DVFS boost: template {} / {} is not 90 / 50, override refused\n", min, step);
+            return Err(EINVAL);
+        }
+        if boost_min != 0 {
+            put32(hw_img, hwdata::PERF_BOOST_MIN, boost_min)?;
+        }
+        if boost_step != 0 {
+            put32(hw_img, hwdata::PERF_BOOST_STEP, boost_step)?;
+        }
+        dev_info!(
+            dev,
+            "DVFS boost minimum utilization {} %, step {} from the module parameters (template 90 %, 50)\n",
+            get32(hw_img, hwdata::PERF_BOOST_MIN)?,
+            get32(hw_img, hwdata::PERF_BOOST_STEP)?
+        );
+    }
+    let base = super::params::perf_base_pstate();
+    if base != 0 {
+        if base >= top {
+            dev_err!(dev, "DVFS base pstate {} is not below the top state {}, override refused\n", base, top);
+            return Err(EINVAL);
+        }
+        let mut ok = get32(hw_img, hwdata::PERF_BOOST_RANGE)? == range(1)?;
+        for off in hwdata::PERF_BASE {
+            ok &= get32(hw_img, off)? == 100;
+        }
+        if !ok {
+            dev_err!(dev, "DVFS base pstate: template words are not base state 1, override refused\n");
+            return Err(EINVAL);
+        }
+        put32(hw_img, hwdata::PERF_BOOST_RANGE, range(base)?)?;
+        for off in hwdata::PERF_BASE {
+            put32(hw_img, off, 100 * base)?;
+        }
+        dev_info!(dev, "DVFS base pstate {} from the module parameter (template 1)\n", base);
+    }
+    Ok(())
+}
