+/// Firmware DVFS boost minimum utilization override, percent (0: the template value, 90).
+pub(crate) fn perf_boost_min() -> u32 {
+    match *module_parameters::g15_perf_boost_min.value() {
+        0 => 0,
+        v => v.clamp(30, 100),
+    }
+}
+
+/// Firmware DVFS boost step override (0: the template value, 50).
+pub(crate) fn perf_boost_step() -> u32 {
+    match *module_parameters::g15_perf_boost_step.value() {
+        0 => 0,
+        v => v.clamp(10, 100),
+    }
+}
+
+/// Firmware DVFS base pstate override (0: the template value, 1). The caller limits it to the
+/// states below the top one.
+pub(crate) fn perf_base_pstate() -> u32 {
+    *module_parameters::g15_perf_base_pstate.value()
+}
